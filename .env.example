# BuildingOps AI — environment configuration
#
# Copy this file to `.env`, or run `make setup`, which does that and generates AUTH_SECRET.
# Both apps read the same file: the API directly, and the web app through
# apps/web/.env.local, which `make setup` creates as a link to it.
#
# Everything here is a safe local default. Nothing in this file is a real secret.

# --- General ----------------------------------------------------------------------------

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# console for people, json for log pipelines
LOG_FORMAT=console

# --- Database ---------------------------------------------------------------------------

# Two roles, on purpose. The API connects as the app role, which is subject to row-level
# security. Migrations and the seed command connect as the owner role. In production the
# API refuses to start if these are the same role or still use these passwords.
DATABASE_URL=postgresql+psycopg://buildingops_app:buildingops_app@localhost:5432/buildingops
DATABASE_ADMIN_URL=postgresql+psycopg://buildingops_owner:buildingops_owner@localhost:5432/buildingops

# --- Web app ----------------------------------------------------------------------------

# Where the Next.js server reaches the API. Never sent to browsers.
API_INTERNAL_URL=http://127.0.0.1:8000

# Public URL of the web app. An https:// URL switches the session cookie to Secure.
AUTH_URL=http://localhost:3000

# Encrypts the session cookie. Generate one with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-the-output-of-openssl-rand-base64-32

# Needed when the web app runs behind a proxy or in a container.
AUTH_TRUST_HOST=true

# --- Demo data --------------------------------------------------------------------------

# Password given to the accounts that `make seed` creates. Fictional local data only.
SEED_DEMO_PASSWORD=BuildingOps-Demo-2026

# Lists the seeded accounts on the sign-in page. Never enable this in production.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_DEMO_PASSWORD=BuildingOps-Demo-2026
